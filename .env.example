# SteemAuto Environment Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# DATABASE CONFIGURATION
# ============================================
DB_HOST=127.0.0.1
DB_USER=steemauto_user
DB_PASSWORD=your_database_password_here
DB_NAME=steemauto

# ============================================
# STEEM BLOCKCHAIN CONFIGURATION
# ============================================
# Your Steem posting private key (WIF format)
# IMPORTANT: Keep this secret and never commit it to git
STEEM_WIF_KEY=your_posting_private_key_here

# Steem RPC endpoints (WebSocket)
STEEM_RPC=wss://api.steemit.com
STEEM_RPC2=wss://api.steemit.com
STEEM_RPC3=wss://api.steemit.com

# Steem HTTP endpoint
STEEM_RPC_HTTP=https://api.steemit.com

# ============================================
# APPLICATION CONFIGURATION
# ============================================
# Environment: development, staging, production
NODE_ENV=production

# Application URL
APP_URL=https://yourdomain.com

# Node.js internal server
NODEJS_SERVER=http://127.0.0.1

# Upvote service port (internal)
UPVOTE_PORT=7412

# ============================================
# REDIS CONFIGURATION (Optional - for caching)
# ============================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================
# EMAIL CONFIGURATION (Optional)
# ============================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_email_password
SMTP_FROM=noreply@yourdomain.com

# ============================================
# LOGGING CONFIGURATION
# ============================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ============================================
# SECURITY CONFIGURATION
# ============================================
# Secret key for JWT tokens (generate a random string)
JWT_SECRET=your_jwt_secret_key_here_use_random_string

# Session secret
SESSION_SECRET=your_session_secret_here_use_random_string

# Cookie domain
COOKIE_DOMAIN=yourdomain.com

# ============================================
# API CONFIGURATION
# ============================================
# API rate limiting
API_RATE_LIMIT=100
API_RATE_WINDOW=3600

# ============================================
# MONITORING (Optional)
# ============================================
# Sentry DSN for error tracking
SENTRY_DSN=

# Google Analytics
GA_TRACKING_ID=

# ============================================
# FEATURE FLAGS
# ============================================
ENABLE_EMAIL_NOTIFICATIONS=false
ENABLE_WEBSOCKET=false
ENABLE_ANALYTICS=false
